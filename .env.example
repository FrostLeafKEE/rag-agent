# 复制为 .env 并填写真实值：cp .env.example .env
# 敏感密钥（JWT_SECRET、LANGFUSE_*）用 `openssl rand -base64 32` 生成

# ===== 基础设施 =====
DOCKER_VOLUME_DIRECTORY=.
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpass
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Langfuse 密钥（必须设置，否则 langfuse 容器启动失败）
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# ===== 应用 =====
APP_ENV=dev
DEBUG=true

# 模型网关（OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 嵌入示例：SiliconFlow → base_url=https://api.siliconflow.cn/v1, model=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# 存储
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=chunks
POSTGRES_DSN=postgresql+asyncpg://rag:ragpass@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=documents

# 可观测（Langfuse 控制台注册后填写）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# 安全
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
CLICKHOUSE_PASSWORD=langfuse
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
