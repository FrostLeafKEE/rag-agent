{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "RAG 系统总览",
  "uid": "rag-overview",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "QPS（请求数/秒）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(rag_http_requests_total[5m]))",
          "legendFormat": "QPS"
        }
      ]
    },
    {
      "id": 2,
      "title": "请求延迟 P95（秒）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_http_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "id": 3,
      "title": "问答检索命中块数",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "rag_qa_retrieved_chunks",
          "legendFormat": "命中块"
        }
      ]
    },
    {
      "id": 4,
      "title": "LLM 调用次数",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(rag_llm_calls_total[5m]))",
          "legendFormat": "调用/秒"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP 状态码分布",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (status) (rate(rag_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
